{
  "name": "barber-os",
  "version": "0.1.0",
  "description": "Open source SaaS platform for barbershop management",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "BarberOS Contributors",
    "url": "https://github.com/marcovsolis/barber-os"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marcovsolis/barber-os.git"
  },
  "keywords": [
    "barbershop",
    "saas",
    "appointments",
    "scheduling",
    "whatsapp",
    "nextjs",
    "supabase"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/database.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.468.0",
    "next": "15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.4.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.3",
    "postcss": "^8",
    "supabase": "^2.7.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
